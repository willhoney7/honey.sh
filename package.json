{
	"name": "honey.sh",
	"version": "0.1.0",
	"private": true,
	"packageManager": "npm@11.6.2",
	"type": "module",
	"scripts": {
		"build-posts": "node --import remix/node-tsx scripts/build-posts.ts",
		"prebuild": "npm run build-posts",
		"build": "vite build",
		"predev": "npm run build-posts",
		"dev": "vite",
		"dev:netlify": "vite --mode netlify",
		"preview": "vite preview",
		"test": "NODE_ENV=test node --import remix/node-tsx --test",
		"typecheck": "tsc --noEmit"
	},
	"engines": {
		"node": "24.x"
	},
	"dependencies": {
		"date-fns": "^4.1.0",
		"remix": "^3.0.0-beta.10"
	},
	"devDependencies": {
		"@ianvs/prettier-plugin-sort-imports": "^4.3.1",
		"@netlify/vite-plugin": "^2.12.9",
		"@pitlane/dev": "^0.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.1",
		"gray-matter": "^4.0.3",
		"netlify-cli": "^27.1.2",
		"prettier": "^3.3.3",
		"remark": "^15.0.1",
		"remark-html": "^16.0.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.6"
	}
}
